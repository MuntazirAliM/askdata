# Copy this file to .env and fill in the values. Never commit .env.

# Admin connection, used only by setup_db.py to build the database.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=shops

# Password given to the read-only roles the AI agent connects as. Choose any value.
AGENT_PASSWORD=choose_a_password_here

# Optional: full path to psql if the scripts cannot find it.
# PSQL_PATH=D:\PostgreSQL\18\bin\psql.exe

# The language model that writes the SQL.
# Local development with Ollama (free, private). Run: ollama pull qwen2.5:7b
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b

# Hosted demo with Groq (free tier):
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=paste_your_key_here